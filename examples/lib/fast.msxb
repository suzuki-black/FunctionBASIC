' ============================================================
'  FAST library  (FunctionBASIC)   INCLUDE "lib/fast.msxb"
'
'  ゲーム向けの「バッチ高速化」プリミティブ集（opt-in の逃げ道レイヤ）。
'  透明で読める MSX-BASIC が既定、これは「速度が要る所だけ」使う道具。
'  各プリミティブは 1:1 命令置換ではなく「1フレーム分の処理を丸ごと ASM に内包」する
'  ことで BASIC<->ASM の往復を毎フレーム1回に抑える。%整数配列を渡し、ASM が内部で回す。
'
'  A batch-speedup primitive set for games (an opt-in escape hatch).
'  Readable MSX-BASIC stays the default; reach for these only where speed matters.
'  Each primitive internalises a whole frame's worth of work in one ASM call.
'
'  収録 / included:
'    FAST_SPRITES(N%) ... 全スプライトの属性(Y/X/絵/色)を OAM へ一括転送
'    FAST_BIGSPRITES(base,n) ... 32x32合成物体(4枚1組)をplane baseからN個一括描画(大型敵/ボス/膨張用)
'    FAST_DRIFT(base,n,vx,vy,wrapx,wrapy) ... スプライト群を等速で動かしX/Y軸ごとにリングラップ
'    FAST_MOVEV(base,n,wrapx,wrapy) ... スプライト群を各自の速度(SVX%/SVY%)で動かしリングラップ(per-object)
'    FAST_STREAM(base,n,vx,vy,xmax,ymax,parky) ... 弾/粒子をactiveだけ流し画面外で自動deactivate(生存数を返す)
'    FAST_TILES(N%)   ... 背景タイルN個を(列/行/キャラ配列で指定して)ネームテーブルへ一括転送
'    FAST_TILEGRID(rows,cols,pitchx) ... 生存マスク配列を直接走査してタイル格子を一括描画
'                        (詰め替え不要。敵編隊/タイルマップのブロック描画向け)
'    FAST_COLLIDE(ns,ne) ... 全弾 x 全敵の AABB 当たりを1回のASMで解決(命中数を返す)
'
'  依存 / requires: MSX (VDP)。スプライトは SCREEN の指定に従う。
' ============================================================

' ------------------------------------------------------------
'  FAST_SPRITES(N%): N枚ぶんのスプライト属性を OAM(&H1B00) へ一括書き込み。
'  呼ぶ前に下の4配列(0..N-1)を埋めておく:
'    SPY%()=Y, SPX%()=X, SPP%()=絵番号(16x16は内部で x4), SPC%()=色
'  純BASICの双子: FOR I=0 TO N-1: PUT SPRITE I,(SPX%(I),SPY%(I)),SPC%(I),SPP%(I): NEXT
'  ASM は BASIC<->VDP の往復を1回に畳むので、枚数が多いほど効く(実証: 10->27fps)。
' ------------------------------------------------------------
FUNCTION FAST_SPRITES(N%)
    GLOBAL SPY%
    GLOBAL SPX%
    GLOBAL SPP%
    GLOBAL SPC%
    GLOBAL SPN%
    GLOBAL PYP%
    GLOBAL PXP%
    GLOBAL PPP%
    GLOBAL PCP%
    SPN% = N%
    PYP% = VARPTR(SPY%(0))
    PXP% = VARPTR(SPX%(0))
    PPP% = VARPTR(SPP%(0))
    PCP% = VARPTR(SPC%(0))
    ASM
      DI
      LD   A,&H00               ' OAM &H1B00 へ書込アドレス設定 / point VDP at OAM (write)
      OUT  (&H99),A
      LD   A,&H5B               ' &H1B OR &H40 / high byte + write bit
      OUT  (&H99),A
      LD   A,(SPN%)             ' 個数 / count
      LD   B,A
FSPRLP:
      LD   HL,(PYP%)            ' Y
      LD   A,(HL)
      OUT  (&H98),A
      INC  HL
      INC  HL
      LD   (PYP%),HL
      LD   HL,(PXP%)            ' X
      LD   A,(HL)
      OUT  (&H98),A
      INC  HL
      INC  HL
      LD   (PXP%),HL
      LD   HL,(PPP%)            ' 絵番号(16x16は x4) / pattern (x4 for 16x16)
      LD   A,(HL)
      ADD  A,A
      ADD  A,A
      OUT  (&H98),A
      INC  HL
      INC  HL
      LD   (PPP%),HL
      LD   HL,(PCP%)            ' 色 / colour
      LD   A,(HL)
      OUT  (&H98),A
      INC  HL
      INC  HL
      LD   (PCP%),HL
      DJNZ FSPRLP
      EI
    END ASM
END FUNCTION

' ------------------------------------------------------------
'  FAST_BIGSPRITES(BASE%, N%): 32x32 の合成物体 N 個を OAM の plane BASE から一括描画。
'  MSX の 16x16 スプライトでは大きな物体(大型敵/ボス/膨張)が作れないので、4枚を 2x2 に
'  組んで1つの大きな絵にする(ハード倍率は全体倍率なので選択的大型化に使えない、の回避)。
'  1物体につきスプライト4枚を消費(planes BASE..BASE+4N-1)。BASE を空けておけば通常の
'  PUT SPRITE / FAST_SPRITES(plane 0 から)と混在できる。N は最大 (32-BASE)/4。
'  呼ぶ前に下の4配列(0..N-1)を用意する:
'    BSY%()=左上Y, BSX%()=左上X, BSP%()=左上象限の絵番号, BSC%()=色
'  絵は 4連番(TL=BSP, TR=BSP+1, BL=BSP+2, BR=BSP+3)= 32x32像を4分割した順。
'  純BASICの双子: 各物体で PUT SPRITE を4回(左上/右上/左下/右下)呼ぶのを1回に畳む。
' ------------------------------------------------------------
FUNCTION FAST_BIGSPRITES(BASE%, N%)
    GLOBAL BSY%
    GLOBAL BSX%
    GLOBAL BSP%
    GLOBAL BSC%
    GLOBAL BSN%
    GLOBAL BSLO%
    GLOBAL BSYP%
    GLOBAL BSXP%
    GLOBAL BSPP%
    GLOBAL BSCP%
    GLOBAL BSYV%
    GLOBAL BSXV%
    GLOBAL BSPV%
    GLOBAL BSCV%
    BSN% = N%
    BSLO% = BASE% * 4          ' OAM 開始オフセット(1スプライト=4バイト)。plane BASE から書く
    BSYP% = VARPTR(BSY%(0))
    BSXP% = VARPTR(BSX%(0))
    BSPP% = VARPTR(BSP%(0))
    BSCP% = VARPTR(BSC%(0))
    ASM
      DI
      LD   A,(BSLO%)            ' OAM &H1B00 + BASE*4 へ書込アドレス設定(他スプライトと混在可)
      OUT  (&H99),A
      LD   A,&H5B
      OUT  (&H99),A
      LD   A,(BSN%)
      OR   A
      JP   Z,BSDONE
      LD   B,A                  ' B = 物体数
BSLP:
      LD   HL,(BSYP%)           ' 左上 Y/X/絵(*4)/色 を作業変数へ
      LD   A,(HL)
      LD   (BSYV%),A
      LD   HL,(BSXP%)
      LD   A,(HL)
      LD   (BSXV%),A
      LD   HL,(BSPP%)
      LD   A,(HL)
      ADD  A,A                  ' 16x16 は絵番号 x4
      ADD  A,A
      LD   (BSPV%),A
      LD   HL,(BSCP%)
      LD   A,(HL)
      LD   (BSCV%),A
      LD   A,(BSYV%)            ' --- TL ---
      OUT  (&H98),A
      LD   A,(BSXV%)
      OUT  (&H98),A
      LD   A,(BSPV%)
      OUT  (&H98),A
      LD   A,(BSCV%)
      OUT  (&H98),A
      LD   A,(BSYV%)            ' --- TR (X+16, 絵+1) ---
      OUT  (&H98),A
      LD   A,(BSXV%)
      ADD  A,16
      OUT  (&H98),A
      LD   A,(BSPV%)
      ADD  A,4
      OUT  (&H98),A
      LD   A,(BSCV%)
      OUT  (&H98),A
      LD   A,(BSYV%)            ' --- BL (Y+16, 絵+2) ---
      ADD  A,16
      OUT  (&H98),A
      LD   A,(BSXV%)
      OUT  (&H98),A
      LD   A,(BSPV%)
      ADD  A,8
      OUT  (&H98),A
      LD   A,(BSCV%)
      OUT  (&H98),A
      LD   A,(BSYV%)            ' --- BR (X+16,Y+16, 絵+3) ---
      ADD  A,16
      OUT  (&H98),A
      LD   A,(BSXV%)
      ADD  A,16
      OUT  (&H98),A
      LD   A,(BSPV%)
      ADD  A,12
      OUT  (&H98),A
      LD   A,(BSCV%)
      OUT  (&H98),A
      LD   HL,(BSYP%)           ' 各ポインタ += 2
      INC  HL
      INC  HL
      LD   (BSYP%),HL
      LD   HL,(BSXP%)
      INC  HL
      INC  HL
      LD   (BSXP%),HL
      LD   HL,(BSPP%)
      INC  HL
      INC  HL
      LD   (BSPP%),HL
      LD   HL,(BSCP%)
      INC  HL
      INC  HL
      LD   (BSCP%),HL
      DEC  B                    ' 本体が長いので DJNZ でなく JP で戻る
      JP   NZ,BSLP
BSDONE:
      EI
    END ASM
END FUNCTION

' ------------------------------------------------------------
'  FAST_DRIFT(BASE%, N%, VX%, VY%, WRAPX%, WRAPY%): スプライト群 [BASE, BASE+N) を
'  「一定速度 (VX,VY) で動かす」を1回のASMで。VX/VY は符号つき小整数(例: -2)。
'  X はリング [0..WRAPX]、Y はリング [0..WRAPY] で自動ラップ(左右/上下どちらの符号でも
'  正しく巻く)。WRAPX%/WRAPY% に 0 を渡すとその軸はラップ無し(素の加算)。
'    横スクロール敵/編隊 => WRAPX=248, WRAPY=0
'    縦スクロール/降る星   => WRAPX=0,   WRAPY=191
'  座標は FAST_SPRITES と同じ SPX%()/SPY%() を直接更新するので、動かした後そのまま
'  FAST_SPRITES(...) で描ける。群を"雑にまるごと"流す用途向け。
'  注意: これは「均一な速度で群を流す」プリミティブ。個別ホーミング等は BASIC 側で。
'  効くのは "多数を同じ規則で動かす" とき。実測交差点 ~7体(それ未満は素のBASICが速い)。
' ------------------------------------------------------------
FUNCTION FAST_DRIFT(BASE%, N%, VX%, VY%, WRAPX%, WRAPY%)
    GLOBAL SPX%
    GLOBAL SPY%
    GLOBAL DN%
    GLOBAL DVX%
    GLOBAL DVY%
    GLOBAL DWX%
    GLOBAL DWY%
    GLOBAL DMX%
    GLOBAL DMY%
    GLOBAL DJX%
    GLOBAL DJY%
    GLOBAL DXPW%
    GLOBAL DYPW%
    DN% = N%
    DVX% = VX% AND 255
    DVY% = VY% AND 255
    IF WRAPX% > 0 THEN
        DWX% = 1
        DMX% = WRAPX%
        IF VX% >= 0 THEN
            DJX% = WRAPX% + 1
        ELSE
            DJX% = 255 - WRAPX%
        END IF
    ELSE
        DWX% = 0
    END IF
    IF WRAPY% > 0 THEN
        DWY% = 1
        DMY% = WRAPY%
        IF VY% >= 0 THEN
            DJY% = WRAPY% + 1
        ELSE
            DJY% = 255 - WRAPY%
        END IF
    ELSE
        DWY% = 0
    END IF
    DXPW% = VARPTR(SPX%(BASE%))
    DYPW% = VARPTR(SPY%(BASE%))
    ASM
      DI
      LD   A,(DN%)
      OR   A
      JP   Z,DRDONE            ' 0体なら何もしない
      LD   B,A                 ' B = 体数カウンタ
DRLP:
      LD   HL,(DXPW%)          ' --- X ---
      LD   A,(HL)
      LD   C,A                 ' C = 現X
      LD   A,(DVX%)
      ADD  A,C                 ' newX = X + VX (mod256)
      LD   C,A
      LD   A,(DWX%)            ' X ラップ有効?
      OR   A
      JR   Z,DRXST
      LD   A,(DMX%)
      CP   C                   ' WRAPX - newX ; newX>WRAPX なら carry
      JR   NC,DRXST
      LD   A,(DJX%)            ' リング幅で補正
      LD   E,A
      LD   A,C
      SUB  E
      LD   C,A
DRXST:
      LD   HL,(DXPW%)          ' X 書き戻し(下位=newX, 上位=0)
      LD   (HL),C
      INC  HL
      LD   (HL),0
      INC  HL
      LD   (DXPW%),HL
      LD   HL,(DYPW%)          ' --- Y ---
      LD   A,(HL)
      LD   C,A                 ' C = 現Y
      LD   A,(DVY%)
      ADD  A,C
      LD   C,A                 ' newY
      LD   A,(DWY%)            ' Y ラップ有効?
      OR   A
      JR   Z,DRYST
      LD   A,(DMY%)
      CP   C
      JR   NC,DRYST
      LD   A,(DJY%)
      LD   E,A
      LD   A,C
      SUB  E
      LD   C,A
DRYST:
      LD   HL,(DYPW%)          ' Y 書き戻し
      LD   (HL),C
      INC  HL
      LD   (HL),0
      INC  HL
      LD   (DYPW%),HL
      DEC  B                   ' 体数-- (本体が長いので DJNZ でなく JP で戻る)
      JP   NZ,DRLP
DRDONE:
      EI
    END ASM
END FUNCTION

' ------------------------------------------------------------
'  FAST_MOVEV(BASE%, N%, WRAPX%, WRAPY%): スプライト群 [BASE, BASE+N) を「各自の速度」で
'  動かす per-object 版（FAST_DRIFT は群一律・こちらは1体ずつ別ベクトル）。散る破片・多方向弾・
'  個別に動く敵など、一律移動では表せない動きを1回のASMで。X/Y はリング [0..WRAP] で自動ラップ
'  （WRAP=0 でその軸はラップ無し）。呼ぶ前に位置＋速度の4配列を [BASE..] で揃える:
'    SPX%()/SPY%()=位置（FAST_SPRITES と共用）, SVX%()/SVY%()=各自の速度（符号つき小整数, 例 -2）
'  純BASICの双子: FOR I: SPX%(I)=(SPX%(I)+SVX%(I))ラップ: SPY%(I)=(SPY%(I)+SVY%(I))ラップ: NEXT
'  速度は |v|<128 かつ WRAP 未満を前提（符号ビットで巻き向きを判定）。動かした後そのまま
'  FAST_SPRITES(...) で描ける。効くのは多数を動かすとき（交差点 ~8体, fast-guide.md 参照）。
' ------------------------------------------------------------
FUNCTION FAST_MOVEV(BASE%, N%, WRAPX%, WRAPY%)
    GLOBAL SPX%
    GLOBAL SPY%
    GLOBAL SVX%
    GLOBAL SVY%
    GLOBAL MVN%
    GLOBAL MVWX%
    GLOBAL MVWY%
    GLOBAL MVMX%
    GLOBAL MVMY%
    GLOBAL MVAXP%
    GLOBAL MVAXN%
    GLOBAL MVAYP%
    GLOBAL MVAYN%
    GLOBAL MVPX%
    GLOBAL MVPY%
    GLOBAL MVVX%
    GLOBAL MVVY%
    MVN% = N%
    IF WRAPX% > 0 THEN
        MVWX% = 1
        MVMX% = WRAPX%
        MVAXP% = WRAPX% + 1
        MVAXN% = 255 - WRAPX%
    ELSE
        MVWX% = 0
    END IF
    IF WRAPY% > 0 THEN
        MVWY% = 1
        MVMY% = WRAPY%
        MVAYP% = WRAPY% + 1
        MVAYN% = 255 - WRAPY%
    ELSE
        MVWY% = 0
    END IF
    MVPX% = VARPTR(SPX%(BASE%))
    MVPY% = VARPTR(SPY%(BASE%))
    MVVX% = VARPTR(SVX%(BASE%))
    MVVY% = VARPTR(SVY%(BASE%))
    ASM
      DI
      LD   A,(MVN%)
      OR   A
      JP   Z,MVDONE
      LD   B,A                 ' B = 体数カウンタ
MVLP:
      LD   HL,(MVPX%)          ' --- X ---
      LD   A,(HL)
      LD   C,A                 ' C = 現X
      LD   HL,(MVVX%)
      LD   A,(HL)
      LD   E,A                 ' E = 各自の VX(符号つきバイト。符号判定に保持)
      ADD  A,C                 ' newX = X + VX (mod256)
      LD   C,A
      LD   A,(MVWX%)           ' X ラップ有効?
      OR   A
      JR   Z,MVXST
      LD   A,(MVMX%)
      CP   C                   ' WRAPX - newX ; newX>WRAPX なら carry(範囲外)
      JR   NC,MVXST
      BIT  7,E                 ' VX の符号で巻き向きを選ぶ(per-object)
      JR   Z,MVXPOS
      LD   A,(MVAXN%)          ' VX<0(左へ) の補正
      JR   MVXADJ
MVXPOS:
      LD   A,(MVAXP%)          ' VX>=0(右へ) の補正
MVXADJ:
      LD   D,A
      LD   A,C
      SUB  D
      LD   C,A
MVXST:
      LD   HL,(MVPX%)          ' X 書き戻し
      LD   (HL),C
      INC  HL
      LD   (HL),0
      INC  HL
      LD   (MVPX%),HL
      LD   HL,(MVVX%)          ' VX ポインタ += 2
      INC  HL
      INC  HL
      LD   (MVVX%),HL
      LD   HL,(MVPY%)          ' --- Y ---
      LD   A,(HL)
      LD   C,A
      LD   HL,(MVVY%)
      LD   A,(HL)
      LD   E,A
      ADD  A,C
      LD   C,A
      LD   A,(MVWY%)
      OR   A
      JR   Z,MVYST
      LD   A,(MVMY%)
      CP   C
      JR   NC,MVYST
      BIT  7,E
      JR   Z,MVYPOS
      LD   A,(MVAYN%)
      JR   MVYADJ
MVYPOS:
      LD   A,(MVAYP%)
MVYADJ:
      LD   D,A
      LD   A,C
      SUB  D
      LD   C,A
MVYST:
      LD   HL,(MVPY%)          ' Y 書き戻し
      LD   (HL),C
      INC  HL
      LD   (HL),0
      INC  HL
      LD   (MVPY%),HL
      LD   HL,(MVVY%)          ' VY ポインタ += 2
      INC  HL
      INC  HL
      LD   (MVVY%),HL
      DEC  B
      JP   NZ,MVLP
MVDONE:
      EI
    END ASM
END FUNCTION

' ------------------------------------------------------------
'  FAST_STREAM(BASE%, N%, VX%, VY%, XMAX%, YMAX%, PARKY%): 弾/粒子など「撃ちっぱなし」
'  の群を1回のASMで。active な物だけを等速 (VX,VY) で流し、プレイ領域 [0..XMAX]x[0..YMAX]
'  を出た物は active=0 にして Y=PARKY(画面外)へ退避する。生存(active)数を返す。
'  呼ぶ前に生存フラグ配列の先頭 VARPTR を設定する: PACT% = VARPTR(active配列(0))。
'    座標は SPX%()/SPY%() の [BASE..] を、生存は active配列(0..N-1) を使う。
'  純BASICの双子: FOR I=0 TO N-1: IF act(I) THEN move; IF 画面外 THEN act(I)=0: Y=PARKY
'  効くのは弾が"多数"のとき(弾幕/粒子)。少数弾(~7以下)は交差点未満なので BASIC で十分。
'  例: PACT% = VARPTR(SACT%(0)) : L% = FAST_STREAM(BB%, MAXB%, 6, 0, 248, 191, 216)
' ------------------------------------------------------------
FUNCTION FAST_STREAM(BASE%, N%, VX%, VY%, XMAX%, YMAX%, PARKY%)
    GLOBAL SPX%
    GLOBAL SPY%
    GLOBAL PACT%
    GLOBAL SMN%
    GLOBAL SMVX%
    GLOBAL SMVY%
    GLOBAL SMXS%
    GLOBAL SMXT%
    GLOBAL SMYS%
    GLOBAL SMYT%
    GLOBAL SMPK%
    GLOBAL SMXP%
    GLOBAL SMYP%
    GLOBAL SMAP%
    GLOBAL SMLIVE%
    SMN% = N%
    SMVX% = VX% AND 255
    SMVY% = VY% AND 255
    SMPK% = PARKY%
    IF VX% > 0 THEN
        SMXS% = 1
        SMXT% = XMAX% - VX%
    ELSEIF VX% < 0 THEN
        SMXS% = 2
        SMXT% = 0 - VX%
    ELSE
        SMXS% = 0
    END IF
    IF VY% > 0 THEN
        SMYS% = 1
        SMYT% = YMAX% - VY%
    ELSEIF VY% < 0 THEN
        SMYS% = 2
        SMYT% = 0 - VY%
    ELSE
        SMYS% = 0
    END IF
    SMLIVE% = 0
    SMXP% = VARPTR(SPX%(BASE%))
    SMYP% = VARPTR(SPY%(BASE%))
    SMAP% = PACT%
    ASM
      DI
      LD   A,(SMN%)
      OR   A
      JP   Z,SMDONE
      LD   B,A                 ' B = 個数カウンタ
SMLP:
      LD   HL,(SMAP%)          ' 生存フラグ
      LD   A,(HL)
      OR   A
      JP   Z,SMNEXT            ' 非activeは移動せずスキップ(ポインタは進める)
      LD   HL,(SMXP%)          ' C = 現X
      LD   A,(HL)
      LD   C,A
      LD   A,(SMXS%)           ' X の画面外判定
      OR   A
      JR   Z,SMXOK
      DEC  A
      JR   NZ,SMXLT            ' SMXS=2 -> "< SMXT" 判定
      LD   A,(SMXT%)           ' SMXS=1 -> "> SMXT" なら kill
      CP   C
      JR   NC,SMXOK
      JP   SMKILL
SMXLT:
      LD   A,(SMXT%)
      LD   E,A
      LD   A,C
      CP   E                   ' oldX - SMXT ; carry(oldX<SMXT)なら kill
      JR   NC,SMXOK
      JP   SMKILL
SMXOK:
      LD   HL,(SMYP%)          ' D = 現Y
      LD   A,(HL)
      LD   D,A
      LD   A,(SMYS%)           ' Y の画面外判定
      OR   A
      JR   Z,SMYOK
      DEC  A
      JR   NZ,SMYLT
      LD   A,(SMYT%)
      CP   D
      JR   NC,SMYOK
      JP   SMKILL
SMYLT:
      LD   A,(SMYT%)
      LD   E,A
      LD   A,D
      CP   E
      JR   NC,SMYOK
      JP   SMKILL
SMYOK:
      LD   A,(SMVX%)           ' 生存 -> 移動して格納
      ADD  A,C
      LD   HL,(SMXP%)
      LD   (HL),A
      INC  HL
      LD   (HL),0
      LD   A,(SMVY%)
      ADD  A,D
      LD   HL,(SMYP%)
      LD   (HL),A
      INC  HL
      LD   (HL),0
      LD   A,(SMLIVE%)         ' 生存数++
      INC  A
      LD   (SMLIVE%),A
      JP   SMNEXT
SMKILL:
      LD   HL,(SMAP%)          ' 画面外 -> active=0, Y=PARKY 退避
      LD   (HL),0
      LD   A,(SMPK%)
      LD   HL,(SMYP%)
      LD   (HL),A
      INC  HL
      LD   (HL),0
SMNEXT:
      LD   HL,(SMXP%)          ' 3ポインタを +2
      INC  HL
      INC  HL
      LD   (SMXP%),HL
      LD   HL,(SMYP%)
      INC  HL
      INC  HL
      LD   (SMYP%),HL
      LD   HL,(SMAP%)
      INC  HL
      INC  HL
      LD   (SMAP%),HL
      DEC  B
      JP   NZ,SMLP
SMDONE:
      EI
    END ASM
    RETURN SMLIVE%
END FUNCTION

' ------------------------------------------------------------
'  FAST_TILES(N%): 背景タイル N 個をネームテーブルへ一括書き込み。
'  呼ぶ前に下の配列(0..N-1)と描画先ベースを埋める:
'    TX%()=列(0..31), TY%()=行(0..23), TC%()=キャラコード, NT%=ネームテーブル先頭(&H1800 等)
'  ASM が各タイルの VRAM アドレス = NT% + 行*32 + 列 を内部計算して VDP へ流す。
'  純BASICの双子: FOR I=0 TO N-1: VPOKE NT%+TY%(I)*32+TX%(I), TC%(I): NEXT
'  タイルが多いほど効く(VPOKE の VDP往復を ASM 1回に畳む)。SCREEN 1/2 のタイル面向け。
' ------------------------------------------------------------
FUNCTION FAST_TILES(N%)
    GLOBAL NT%
    GLOBAL TX%
    GLOBAL TY%
    GLOBAL TC%
    GLOBAL FTN%
    GLOBAL FTB%
    GLOBAL FTXP%
    GLOBAL FTYP%
    GLOBAL FTCP%
    FTN% = N%
    FTB% = NT%
    FTXP% = VARPTR(TX%(0))
    FTYP% = VARPTR(TY%(0))
    FTCP% = VARPTR(TC%(0))
    ASM
      DI
      LD   A,(FTN%)
      OR   A
      JP   Z,FTDONE            ' 0枚なら何もしない(DJNZ の 256 回暴走防止)
      LD   B,A                 ' B = 枚数カウンタ
FTLOOP:
      LD   HL,(FTYP%)          ' HL -> TY(i)
      LD   A,(HL)              ' A = 行(下位)
      LD   L,A
      LD   H,0                 ' HL = 行
      ADD  HL,HL               ' *2
      ADD  HL,HL               ' *4
      ADD  HL,HL               ' *8
      ADD  HL,HL               ' *16
      ADD  HL,HL               ' *32  -> HL = 行*32
      EX   DE,HL               ' DE = 行*32
      LD   HL,(FTXP%)          ' HL -> TX(i)
      LD   A,(HL)              ' A = 列
      LD   L,A
      LD   H,0                 ' HL = 列
      ADD  HL,DE               ' HL = 行*32 + 列
      LD   DE,(FTB%)           ' DE = ベース(NT)
      ADD  HL,DE               ' HL = VRAM アドレス
      LD   A,L                 ' VDP 書込アドレス設定(下位)
      OUT  (&H99),A
      LD   A,H
      AND  &H3F
      OR   &H40                ' 上位 | 書込ビット
      OUT  (&H99),A
      LD   HL,(FTCP%)          ' キャラを出力
      LD   A,(HL)
      OUT  (&H98),A
      LD   HL,(FTXP%)          ' 各ポインタを次要素へ(+2)
      INC  HL
      INC  HL
      LD   (FTXP%),HL
      LD   HL,(FTYP%)
      INC  HL
      INC  HL
      LD   (FTYP%),HL
      LD   HL,(FTCP%)
      INC  HL
      INC  HL
      LD   (FTCP%),HL
      DJNZ FTLOOP
FTDONE:
      EI
    END ASM
END FUNCTION

' ------------------------------------------------------------
'  FAST_TILEGRID(ROWS%, COLS%, PITCHX%): 生存マスクを直接走査してタイル格子を一括描画。
'  「詰め替え」不要が肝: 呼ぶ前にゲームは "行ごと"(=ROWS個だけ)の情報を用意する:
'    TGRA%(r) = 行 r の左端タイルの VRAM アドレス (= NT% + (原点行+r*行間隔)*32 + 原点列)
'    TGRC%(r) = 行 r に描くキャラコード (消去なら 32)
'    TGAL%(r*COLS%+c) = 生存フラグ(1/0)  … ゲームの生存配列をそのまま使う
'  そして各配列先頭の VARPTR を下の3つに入れてから呼ぶ:
'    TGAP0% = VARPTR(TGAL%(0)), TGRP0% = VARPTR(TGRA%(0)), TGHP0% = VARPTR(TGRC%(0))
'  ASM が行x列を走査し、生存セルだけ TGRA%(r)+c*PITCHX% へ TGRC%(r) を書く。
'  BASIC 側の per-cell 詰め替えが無いので、列挙型 FAST_TILES より遥かに軽い。
' ------------------------------------------------------------
FUNCTION FAST_TILEGRID(ROWS%, COLS%, PITCHX%)
    GLOBAL TGAP0%
    GLOBAL TGRP0%
    GLOBAL TGHP0%
    GLOBAL TGRN%
    GLOBAL TGCN%
    GLOBAL TGPX%
    GLOBAL TGAP%
    GLOBAL TGRP%
    GLOBAL TGHP%
    GLOBAL TGRK%
    GLOBAL TGCK%
    GLOBAL TGAD%
    GLOBAL TGCH%
    TGRN% = ROWS%
    TGCN% = COLS%
    TGPX% = PITCHX%
    TGAP% = TGAP0%
    TGRP% = TGRP0%
    TGHP% = TGHP0%
    ASM
      DI
      LD   A,(TGRN%)
      LD   (TGRK%),A            ' 行カウンタ = ROWS
GTGROW:
      LD   A,(TGRK%)
      OR   A
      JP   Z,GTGEND
      LD   HL,(TGRP%)           ' TGAD% <- 行アドレス配列の現要素(word)
      LD   E,(HL)
      INC  HL
      LD   D,(HL)
      LD   (TGAD%),DE
      LD   HL,(TGRP%)           ' 行アドレスptr += 2
      INC  HL
      INC  HL
      LD   (TGRP%),HL
      LD   HL,(TGHP%)           ' TGCH% <- 行キャラ配列の現要素(byte)
      LD   A,(HL)
      LD   (TGCH%),A
      LD   HL,(TGHP%)           ' 行キャラptr += 2
      INC  HL
      INC  HL
      LD   (TGHP%),HL
      LD   A,(TGCN%)            ' 列カウンタ = COLS
      LD   (TGCK%),A
GTGCOL:
      LD   A,(TGCK%)
      OR   A
      JP   Z,GTGNR
      LD   HL,(TGAP%)           ' if 生存(idx) then 書く
      LD   A,(HL)
      OR   A
      JP   Z,GTGSK
      LD   HL,(TGAD%)           ' VDP 書込アドレス設定
      LD   A,L
      OUT  (&H99),A
      LD   A,H
      AND  &H3F
      OR   &H40
      OUT  (&H99),A
      LD   A,(TGCH%)
      OUT  (&H98),A
GTGSK:
      LD   HL,(TGAP%)           ' 生存ptr += 2
      INC  HL
      INC  HL
      LD   (TGAP%),HL
      LD   HL,(TGAD%)           ' セルアドレス += PITCHX
      LD   A,(TGPX%)
      LD   E,A
      LD   D,0
      ADD  HL,DE
      LD   (TGAD%),HL
      LD   A,(TGCK%)            ' 列カウンタ--
      DEC  A
      LD   (TGCK%),A
      JP   GTGCOL
GTGNR:
      LD   A,(TGRK%)            ' 行カウンタ--
      DEC  A
      LD   (TGRK%),A
      JP   GTGROW
GTGEND:
      EI
    END ASM
END FUNCTION

' ------------------------------------------------------------
'  FAST_COLLIDE(NS%, NE%): 全弾 x 全敵の AABB(16px)当たりを「1回のASM呼び出し」で解決。
'  命中した弾は非アクティブ＋Y=216(隠し)、当たった敵は X=248(右端へ復活・Yレーン維持)。命中数を返す。
'  弾ごとのBASIC処理がゼロなので、撃ち込んでも速度が落ちない(STG/アクションの発射コスト対策)。
'  呼ぶ前に各配列先頭アドレスを設定する:
'    PSX%=VARPTR(弾X(0)) PSY%=VARPTR(弾Y(0)) PSA%=VARPTR(弾生存(0))
'    PEX%=VARPTR(敵X(0)) PEY%=VARPTR(敵Y(0))
'  例: H% = FAST_COLLIDE(弾数, 敵数)  '命中数
' ------------------------------------------------------------
FUNCTION FAST_COLLIDE(NS%, NE%)
    GLOBAL CSN%
    GLOBAL CEN%
    GLOBAL CHIT%
    GLOBAL PSX%
    GLOBAL PSY%
    GLOBAL PSA%
    GLOBAL PEX%
    GLOBAL PEY%
    GLOBAL WSX%
    GLOBAL WSY%
    GLOBAL WSA%
    GLOBAL WEX%
    GLOBAL WEY%
    GLOBAL CSC%
    GLOBAL CEC%
    GLOBAL SXV%
    GLOBAL SYV%
    CSN% = NS%
    CEN% = NE%
    CHIT% = 0
    WSX% = 0
    WSY% = 0
    WSA% = 0
    WEX% = 0
    WEY% = 0
    CSC% = 0
    CEC% = 0
    SXV% = 0
    SYV% = 0
    ASM
      DI
      LD   HL,(PSX%)
      LD   (WSX%),HL
      LD   HL,(PSY%)
      LD   (WSY%),HL
      LD   HL,(PSA%)
      LD   (WSA%),HL
      LD   A,(CSN%)
      LD   (CSC%),A
CCSHOT:
      LD   A,(CSC%)
      OR   A
      JP   Z,CCDONE
      LD   HL,(WSA%)
      LD   A,(HL)
      OR   A
      JP   Z,CCNXTS
      LD   HL,(PEX%)
      LD   (WEX%),HL
      LD   HL,(PEY%)
      LD   (WEY%),HL
      LD   A,(CEN%)
      LD   (CEC%),A
      LD   HL,(WSX%)
      LD   A,(HL)
      LD   (SXV%),A
      LD   HL,(WSY%)
      LD   A,(HL)
      LD   (SYV%),A
CCENE:
      LD   A,(CEC%)
      OR   A
      JP   Z,CCNXTS
      LD   HL,(WEX%)
      LD   A,(HL)
      LD   B,A
      LD   A,(SXV%)
      SUB  B
      ADD  A,15
      CP   31
      JP   NC,CCNXTE
      LD   HL,(WEY%)
      LD   A,(HL)
      LD   B,A
      LD   A,(SYV%)
      SUB  B
      ADD  A,15
      CP   31
      JP   NC,CCNXTE
      LD   HL,(WSA%)
      LD   (HL),0
      LD   HL,(WSY%)
      LD   (HL),216
      LD   HL,(WEX%)
      LD   (HL),248
      LD   A,(CHIT%)
      INC  A
      LD   (CHIT%),A
      JP   CCNXTS
CCNXTE:
      LD   HL,(WEX%)
      INC  HL
      INC  HL
      LD   (WEX%),HL
      LD   HL,(WEY%)
      INC  HL
      INC  HL
      LD   (WEY%),HL
      LD   A,(CEC%)
      DEC  A
      LD   (CEC%),A
      JP   CCENE
CCNXTS:
      LD   HL,(WSX%)
      INC  HL
      INC  HL
      LD   (WSX%),HL
      LD   HL,(WSY%)
      INC  HL
      INC  HL
      LD   (WSY%),HL
      LD   HL,(WSA%)
      INC  HL
      INC  HL
      LD   (WSA%),HL
      LD   A,(CSC%)
      DEC  A
      LD   (CSC%),A
      JP   CCSHOT
CCDONE:
      EI
    END ASM
    RETURN CHIT%
END FUNCTION
