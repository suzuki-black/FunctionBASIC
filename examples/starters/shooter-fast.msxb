' ============================================================
'  横スクロールSTG - FASTフル活用版
'  Horizontal shooter - FAST version (uses the FAST library heavily)
'
'  shooter-nofast.msxb と「全く同じ仕様」。下の共有CONSTを同じ値にすれば同一ゲーム。
'  違いは重い所だけ: 移動=FAST_STREAM(一括)、描画=FAST_SPRITES(一括)。
'  当たり判定・入力・背景・HUD は no-fast と同一(公平のため)。
'  Same spec as shooter-nofast.msxb (match the shared CONSTs). Only the heavy parts differ:
'  movement via FAST_STREAM, drawing via FAST_SPRITES. Collision/input/BG/HUD are identical.
'
'  そうさ / CONTROLS: 上下=移動 / up-down, スペース=発射 / SPACE=fire
'
'  * 数字をいじって遊ぼう / TWEAK ME:
'    既定 MAX_ENEMY%=26 でも、このFAST版は敵を一括処理するので軽い（＝FASTの威力）。
'    比較用の shooter-nofast.msxb を同じ MAX_ENEMY%=26 で動かすと、あちらは重い。
'    両方の MAX_ENEMY% を同じ値にすれば全く同じゲーム。数字を変えて試してみて！
'    Even at MAX_ENEMY%=26 this FAST build stays light (batch processing = the FAST win).
'    Run shooter-nofast.msxb at the same MAX_ENEMY% to feel the difference. Keep both
'    files' CONSTs equal for the identical game. Change the numbers and experiment!
'
'  MSX turbo R 専用 / needs MSX turbo R.
'  背景スクロールに SET SCROLL を使う。SET SCROLL は turbo R(BASIC 4.0)専用命令なので
'  MSX2/MSX2+ では動かない(エラーになる)。turbo R は CPU も速いので体感も軽い。
'  Uses SET SCROLL for the background, which is a turbo R (BASIC 4.0) only command; it does
'  NOT run on MSX2/MSX2+. turbo R is also the fastest MSX, so the game feels lighter too.
'  WebMSX なら機種を turbo R(MSXTR) にして実行する / run with the turbo R machine (MSXTR).
' ============================================================

' ====== 共有CONST(no-fast版と同値なら同一仕様) / shared CONSTs ======
CONST MAX_ENEMY% = 26
CONST MAX_SHOT% = 4
CONST ENEMY_DX% = 2
CONST SHOT_DX% = 5
CONST PLAYER_DY% = 3
CONST FIRE_COOL% = 6
CONST SCROLL_DX% = 2
' ====== ここまで共有 / end shared ======

CONST PLAYER_X% = 16
CONST TOP_Y% = 16
CONST BOT_Y% = 168
CONST HIDE_Y% = 216

' 全スプライトを1本の配列にまとめる(FAST_SPRITESが一括描画) / all sprites in one set of arrays
GLOBAL SPY%
GLOBAL SPX%
GLOBAL SPP%
GLOBAL SPC%
GLOBAL SACT%
' FAST_SPRITES 用 / for FAST_SPRITES
GLOBAL SPN%
GLOBAL PYP%
GLOBAL PXP%
GLOBAL PPP%
GLOBAL PCP%
' FAST_STREAM 用 / for FAST_STREAM
GLOBAL PSTR%
GLOBAL STN%
GLOBAL STD%
GLOBAL STC%
' FAST_COLLIDE 用 / for FAST_COLLIDE
GLOBAL CSN%
GLOBAL CEN%
GLOBAL CHIT%
GLOBAL PSX%
GLOBAL PSY%
GLOBAL PSA%
GLOBAL PEX%
GLOBAL PEY%
GLOBAL WSX%
GLOBAL WSY%
GLOBAL WSA%
GLOBAL WEX%
GLOBAL WEY%
GLOBAL CSC%
GLOBAL CEC%
GLOBAL SXV%
GLOBAL SYV%
GLOBAL SCORE%
GLOBAL HUD_DIRTY%

FUNCTION DRAW_HUD()
    GLOBAL SCORE%
    LOCATE 0, 0
    PRINT "SCORE"; SCORE%;
END FUNCTION

' ------------------------------------------------------------
'  FAST_SPRITES: 全スプライトの属性を OAM(&H1B00) へ一括書き込み(実証済み)。
'  Flush every sprite's attributes to OAM in one VDP burst. (proven primitive)
' ------------------------------------------------------------
FUNCTION FAST_SPRITES(N%)
    GLOBAL SPY%
    GLOBAL SPX%
    GLOBAL SPP%
    GLOBAL SPC%
    GLOBAL SPN%
    GLOBAL PYP%
    GLOBAL PXP%
    GLOBAL PPP%
    GLOBAL PCP%
    SPN% = N%
    PYP% = VARPTR(SPY%(0))
    PXP% = VARPTR(SPX%(0))
    PPP% = VARPTR(SPP%(0))
    PCP% = VARPTR(SPC%(0))
    ASM
      DI
      LD   A,&H00               ' OAM &H1B00 へ書込アドレス設定 / point VDP at OAM (write)
      OUT  (&H99),A
      LD   A,&H5B               ' &H1B OR &H40 / high byte + write bit
      OUT  (&H99),A
      LD   A,(SPN%)             ' 個数 / count
      LD   B,A
SPRLP:
      LD   HL,(PYP%)            ' Y
      LD   A,(HL)
      OUT  (&H98),A
      INC  HL
      INC  HL
      LD   (PYP%),HL
      LD   HL,(PXP%)            ' X
      LD   A,(HL)
      OUT  (&H98),A
      INC  HL
      INC  HL
      LD   (PXP%),HL
      LD   HL,(PPP%)            ' 絵番号(16x16は x4) / pattern (x4 for 16x16)
      LD   A,(HL)
      ADD  A,A
      ADD  A,A
      OUT  (&H98),A
      INC  HL
      INC  HL
      LD   (PPP%),HL
      LD   HL,(PCP%)            ' 色 / colour
      LD   A,(HL)
      OUT  (&H98),A
      INC  HL
      INC  HL
      LD   (PCP%),HL
      DJNZ SPRLP
      EI
    END ASM
END FUNCTION

' ------------------------------------------------------------
'  FAST_STREAM: 位置配列の各要素に定数DELTAを一括で足す(バイトが自然に循環)。
'  呼ぶ前に PSTR% = VARPTR(位置配列の先頭要素) を設定する。
'  双子(同じ動作の読めるBASIC): FOR I=0 TO N-1: POS(I)=(POS(I)+DELTA) AND 255: NEXT
'  Add a constant DELTA to every element of a position array (the byte wraps naturally).
'  Set PSTR% = VARPTR(first element) before calling.
' ------------------------------------------------------------
FUNCTION FAST_STREAM(N%, DELTA%)
    GLOBAL PSTR%
    GLOBAL STN%
    GLOBAL STD%
    GLOBAL STC%
    STN% = N%
    STD% = DELTA%
    STC% = 0                     ' ASMが使う作業変数も先に作る(VARPTR不正防止) / pre-create ASM scratch
    ASM
      DI
      LD   A,(STN%)             ' 個数 -> カウンタ / count -> counter
      LD   (STC%),A
      LD   A,(STD%)             ' A = 変化量(下位バイト) / delta low byte
      LD   B,A                  ' B = 変化量を保持 / keep delta in B
STLP:
      LD   HL,(PSTR%)           ' HL -> 位置要素 / -> pos element
      LD   A,(HL)               ' A = 位置(下位) / pos low byte
      ADD  A,B                  ' 位置 += 変化量(バイトは自然に循環) / pos += delta (byte wraps)
      LD   (HL),A               ' 下位を書き戻す / store low byte
      INC  HL
      LD   (HL),0               ' 上位=0を維持 / keep high byte 0
      LD   HL,(PSTR%)           ' ポインタを次要素へ +2 / advance pointer
      INC  HL
      INC  HL
      LD   (PSTR%),HL
      LD   A,(STC%)             ' カウンタ-- / counter--
      DEC  A
      LD   (STC%),A
      JR   NZ,STLP
      EI
    END ASM
END FUNCTION

' ------------------------------------------------------------
'  FAST_COLLIDE: 全弾x全敵の当たり判定を「1回のASM呼び出し」で完結。命中した弾は消え、
'  当たった敵は同じ高さ(レーン)のまま右端へ復活。命中数を返す(BASICでスコア加算)。
'  弾ごとのBASIC呼び出しが無いので、撃ち込んでも速度が落ちない。
'  入れ子ループでジャンプ距離が長くなるため、位置独立でも動く長距離 JP(再配置)を使う。
'  呼ぶ前に PSX%/PSY%/PSA%(弾のX/Y/生存フラグ), PEX%/PEY%(敵のX/Y)の先頭アドレスを設定。
'  Resolve ALL shot-vs-enemy collisions in one ASM call: dead shot hidden, hit enemy
'  respawns at the right edge keeping its lane; returns the hit count. No per-shot BASIC,
'  so firing does not slow the game. Uses relocatable long JP (position-independent).
' ------------------------------------------------------------
FUNCTION FAST_COLLIDE(NS%, NE%)
    GLOBAL CSN%
    GLOBAL CEN%
    GLOBAL CHIT%
    GLOBAL PSX%
    GLOBAL PSY%
    GLOBAL PSA%
    GLOBAL PEX%
    GLOBAL PEY%
    GLOBAL WSX%
    GLOBAL WSY%
    GLOBAL WSA%
    GLOBAL WEX%
    GLOBAL WEY%
    GLOBAL CSC%
    GLOBAL CEC%
    GLOBAL SXV%
    GLOBAL SYV%
    CSN% = NS%
    CEN% = NE%
    CHIT% = 0                     ' 命中数(戻り値) / hit count (return value)
    WSX% = 0                      ' 以降は全てASMが使う作業変数。先に生成しておく(VARPTR対策)。
    WSY% = 0
    WSA% = 0
    WEX% = 0
    WEY% = 0
    CSC% = 0
    CEC% = 0
    SXV% = 0
    SYV% = 0
    ASM
      DI
      LD   HL,(PSX%)           ' 作業ポインタを弾配列の先頭に / init working shot pointers
      LD   (WSX%),HL
      LD   HL,(PSY%)
      LD   (WSY%),HL
      LD   HL,(PSA%)
      LD   (WSA%),HL
      LD   A,(CSN%)
      LD   (CSC%),A            ' 残り弾数 / shots remaining
CCSHOT:                         ' --- 弾ループ(外側) / outer loop over shots ---
      LD   A,(CSC%)
      OR   A
      JP   Z,CCDONE            ' 全弾終了 / all shots done (long jump)
      LD   HL,(WSA%)
      LD   A,(HL)
      OR   A
      JP   Z,CCNXTS            ' 非アクティブな弾はスキップ / inactive shot
      LD   HL,(PEX%)          ' 敵ポインタを先頭にリセット / reset enemy pointers each shot
      LD   (WEX%),HL
      LD   HL,(PEY%)
      LD   (WEY%),HL
      LD   A,(CEN%)
      LD   (CEC%),A           ' 残り敵数 / enemies remaining
      LD   HL,(WSX%)          ' この弾のX,Yを控える / cache this shot's X,Y
      LD   A,(HL)
      LD   (SXV%),A
      LD   HL,(WSY%)
      LD   A,(HL)
      LD   (SYV%),A
CCENE:                          ' --- 敵ループ(内側) / inner loop over enemies ---
      LD   A,(CEC%)
      OR   A
      JP   Z,CCNXTS           ' この弾は命中なし -> 次の弾 / miss -> next shot
      LD   HL,(WEX%)          ' |SX-EX|<16 ? / X within 16px
      LD   A,(HL)
      LD   B,A
      LD   A,(SXV%)
      SUB  B
      ADD  A,15
      CP   31
      JP   NC,CCNXTE          ' X遠い / too far in X
      LD   HL,(WEY%)          ' |SY-EY|<16 ? / Y within 16px
      LD   A,(HL)
      LD   B,A
      LD   A,(SYV%)
      SUB  B
      ADD  A,15
      CP   31
      JP   NC,CCNXTE          ' Y遠い / too far in Y
      ' 命中! / HIT
      LD   HL,(WSA%)
      LD   (HL),0            ' 弾を非アクティブに / shot inactive
      LD   HL,(WSY%)
      LD   (HL),216         ' 弾Yを隠し位置へ / hide the shot
      LD   HL,(WEX%)
      LD   (HL),248         ' 敵Xを右端へ(Y=レーン維持) / respawn enemy X (keep Y)
      LD   A,(CHIT%)
      INC  A
      LD   (CHIT%),A        ' 命中数++ / hit count++
      JP   CCNXTS           ' 弾は消費 -> 次の弾 / shot consumed
CCNXTE:                         ' 次の敵へ / next enemy
      LD   HL,(WEX%)
      INC  HL
      INC  HL
      LD   (WEX%),HL
      LD   HL,(WEY%)
      INC  HL
      INC  HL
      LD   (WEY%),HL
      LD   A,(CEC%)
      DEC  A
      LD   (CEC%),A
      JP   CCENE
CCNXTS:                         ' 次の弾へ / next shot
      LD   HL,(WSX%)
      INC  HL
      INC  HL
      LD   (WSX%),HL
      LD   HL,(WSY%)
      INC  HL
      INC  HL
      LD   (WSY%),HL
      LD   HL,(WSA%)
      INC  HL
      INC  HL
      LD   (WSA%),HL
      LD   A,(CSC%)
      DEC  A
      LD   (CSC%),A
      JP   CCSHOT
CCDONE:
      EI
    END ASM
    RETURN CHIT%
END FUNCTION

' ---------------- MAIN ----------------
SCREEN 1, 2
WIDTH 32
COLOR 15, 1, 1
KEY OFF
CLS

DIM SPY%(31)
DIM SPX%(31)
DIM SPP%(31)
DIM SPC%(31)
DIM SACT%(MAX_SHOT% - 1)

SPRITE PLAYER
    "................"
    "..##............"
    "..####.........."
    "..######........"
    "..########......"
    "..##########...."
    "..############.."
    "..##############"
    "..############.."
    "..##########...."
    "..########......"
    "..######........"
    "..####.........."
    "..##............"
    "................"
    "................"
END SPRITE

SPRITE ENEMYP
    "................"
    "......####......"
    "....########...."
    "..####....####.."
    "..##.##..##.##.."
    "..##########.##."
    ".##############."
    ".##.########.##."
    ".##.########.##."
    ".##############."
    "..##########...."
    "..##......##...."
    ".##........##..."
    ".##........##..."
    "................"
    "................"
END SPRITE

SPRITE SHOTP
    "................"
    "................"
    "................"
    "................"
    "................"
    "......####......"
    "....########...."
    "....########...."
    "....########...."
    "......####......"
    "................"
    "................"
    "................"
    "................"
    "................"
    "................"
END SPRITE

FOR I% = 0 TO 23
    LOCATE (I% * 7) AND 31, (I% * 5) AND 23
    PRINT ".";
NEXT I%

' インデックス割当: 0=自機, 1..=敵, その後=弾 / layout: 0=player, then enemies, then shots
ESB% = 1
SSB% = 1 + MAX_ENEMY%
TOT% = 1 + MAX_ENEMY% + MAX_SHOT%

PY% = 90
SCORE% = 0
HUD_DIRTY% = 1
FIRE_TMR% = 0
SCX% = 0

' 自機(index 0) / player
SPX%(0) = PLAYER_X%
SPY%(0) = PY%
SPP%(0) = PLAYER
SPC%(0) = 15
' 敵(常時表示) / enemies (always active)
FOR I% = 0 TO MAX_ENEMY% - 1
    SPX%(ESB% + I%) = (40 + I% * 16) AND 255
    SPY%(ESB% + I%) = TOP_Y% + INT(RND(1) * (BOT_Y% - TOP_Y%))
    SPP%(ESB% + I%) = ENEMYP
    SPC%(ESB% + I%) = 8
NEXT I%
' 弾(最初は非表示) / shots (start hidden)
FOR I% = 0 TO MAX_SHOT% - 1
    SPX%(SSB% + I%) = 0
    SPY%(SSB% + I%) = HIDE_Y%
    SPP%(SSB% + I%) = SHOTP
    SPC%(SSB% + I%) = 11
    SACT%(I%) = 0
NEXT I%

WHILE 1
    ' 1) フレーム同期 / frame sync
    FR = TIME
    DO WHILE TIME = FR
    LOOP

    ' 2) 入力: 上下移動 / input
    JOY% = STICK(0)
    IF JOY% = 1 OR JOY% = 2 OR JOY% = 8 THEN
        PY% = PY% - PLAYER_DY%
        IF PY% < TOP_Y% THEN
            PY% = TOP_Y%
        END IF
    END IF
    IF JOY% = 4 OR JOY% = 5 OR JOY% = 6 THEN
        PY% = PY% + PLAYER_DY%
        IF PY% > BOT_Y% THEN
            PY% = BOT_Y%
        END IF
    END IF
    SPY%(0) = PY%

    ' 3) 発射 / fire (with cooldown)
    IF FIRE_TMR% > 0 THEN
        FIRE_TMR% = FIRE_TMR% - 1
    END IF
    IF STRIG(0) AND FIRE_TMR% <= 0 THEN
        FIRED% = 0
        FOR I% = 0 TO MAX_SHOT% - 1
            IF FIRED% = 0 AND SACT%(I%) = 0 THEN
                SACT%(I%) = 1
                SPX%(SSB% + I%) = PLAYER_X% + 16
                SPY%(SSB% + I%) = PY%
                FIRED% = 1
                FIRE_TMR% = FIRE_COOL%
            END IF
        NEXT I%
    END IF

    ' 4) 敵と弾の移動を一括ASM / move enemies and shots in ASM
    PSTR% = VARPTR(SPX%(ESB%))
    FAST_STREAM(MAX_ENEMY%, 0 - ENEMY_DX%)
    PSTR% = VARPTR(SPX%(SSB%))
    FAST_STREAM(MAX_SHOT%, SHOT_DX%)

    ' 5) 弾が右端を越えたら消す / despawn shots past the right edge  [BASIC]
    FOR I% = 0 TO MAX_SHOT% - 1
        IF SACT%(I%) = 1 THEN
            IF SPX%(SSB% + I%) > 240 THEN
                SACT%(I%) = 0
                SPY%(SSB% + I%) = HIDE_Y%
            END IF
        END IF
    NEXT I%

    ' 6) 当たり判定: 全弾x全敵を「1回のASM呼び出し」で / all collision in ONE ASM call
    '    弾ごとのBASIC処理がゼロなので、撃ち込んでも速度が落ちない。命中数だけ受け取る。
    PSX% = VARPTR(SPX%(SSB%))
    PSY% = VARPTR(SPY%(SSB%))
    PSA% = VARPTR(SACT%(0))
    PEX% = VARPTR(SPX%(ESB%))
    PEY% = VARPTR(SPY%(ESB%))
    H% = FAST_COLLIDE(MAX_SHOT%, MAX_ENEMY%)
    IF H% > 0 THEN
        SCORE% = SCORE% + H%
        HUD_DIRTY% = 1
    END IF

    ' 7) 全スプライトを一括描画 / draw ALL sprites in one shot
    FAST_SPRITES(TOT%)

    ' 8) 背景スクロール / scroll the background
    SCX% = (SCX% + SCROLL_DX%) AND 255
    SET SCROLL SCX%, 0, 1, 1

    ' 9) スコア表示(変化時のみ) / HUD only when changed
    IF HUD_DIRTY% = 1 THEN
        DRAW_HUD()
        HUD_DIRTY% = 0
    END IF
WEND
